<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/language_definitions.rxg -->

<language_definitions>
  <language processor="SH3"
            endian="big"
            size="32"
            variant="default"
            version="1.0"
            slafile="sh3.sla"
            processorspec="sh.pspec"
            id="sh3:BE:32:default">
    <description>Hitachi/Renesas SH-3, 32-bit big-endian</description>
    <compiler name="default" spec="sh.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="sh.dwarf"/>
  </language>
  <language processor="SH3"
            endian="little"
            size="32"
            variant="default"
            version="1.0"
            slafile="sh3_le.sla"
            processorspec="sh.pspec"
            id="sh3:LE:32:default">
    <description>Hitachi/Renesas SH-3, 32-bit little-endian</description>
    <compiler name="default" spec="sh.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="sh.dwarf"/>
  </language>
  <language processor="SH3E"
            endian="big"
            size="32"
            variant="default"
            version="1.0"
            slafile="sh3e.sla"
            processorspec="sh.pspec"
            id="sh3e:BE:32:default">
    <description>Hitachi/Renesas SH-3E (SH-3 with FPU), 32-bit big-endian</description>
    <compiler name="default" spec="sh_fpu.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="sh_fpu.dwarf"/>
  </language>
  <language processor="SH3E"
            endian="little"
            size="32"
            variant="default"
            version="1.0"
            slafile="sh3e_le.sla"
            processorspec="sh.pspec"
            id="sh3e:LE:32:default">
    <description>Hitachi/Renesas SH-3E (SH-3 with FPU), 32-bit little-endian</description>
    <compiler name="default" spec="sh_fpu.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="sh_fpu.dwarf"/>
  </language>
  <language processor="SH2E"
            endian="big"
            size="32"
            variant="default"
            version="1.0"
            slafile="sh2e.sla"
            processorspec="sh.pspec"
            id="sh2e:BE:32:default">
    <description>Hitachi/Renesas SH-2E (SH-2 with FPU), 32-bit big-endian</description>
    <compiler name="default" spec="sh_fpu.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="sh_fpu.dwarf"/>
  </language>
</language_definitions>
